<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days of logs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag mit Einträgen</string>
			<key>other</key>
			<string>%lld Tage mit Einträgen</string>
		</dict>
	</dict>
	<key>%lld days · worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · am stärksten %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag</string>
			<key>other</key>
			<string>%lld Tage</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · %@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Eintrag</string>
			<key>other</key>
			<string>%lld Einträge</string>
		</dict>
	</dict>
	<key>%lld tablets left. Time to ask for a refill.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Noch %lld Tablette. Zeit für ein Folgerezept.</string>
			<key>other</key>
			<string>Noch %lld Tabletten. Zeit für ein Folgerezept.</string>
		</dict>
	</dict>
	<key>%lld weight entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Gewichtseintrag</string>
			<key>other</key>
			<string>%lld Gewichtseinträge</string>
		</dict>
	</dict>
	<key>%lld-day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag in Folge</string>
			<key>other</key>
			<string>%lld Tage in Folge</string>
		</dict>
	</dict>
	<key>- %@: %lld days, worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>- %@: %#@n@, am stärksten %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag</string>
			<key>other</key>
			<string>%lld Tage</string>
		</dict>
	</dict>
	<key>About %lld days left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Reicht noch etwa %lld Tag</string>
			<key>other</key>
			<string>Reicht noch etwa %lld Tage</string>
		</dict>
	</dict>
	<key>Showing %lld days from Apple Health.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag aus Apple Health wird angezeigt.</string>
			<key>other</key>
			<string>%lld Tage aus Apple Health werden angezeigt.</string>
		</dict>
	</dict>
</dict>
</plist>
