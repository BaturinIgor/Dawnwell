		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Mostrando %lld día de Apple Salud.</string>
			<key>other</key>
			<string>Mostrando %lld días de Apple Salud.</string>
		</dict>
	</dict>
</dict>
</plist>
