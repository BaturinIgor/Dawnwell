<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days of logs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld día con registros</string>
			<key>other</key>
			<string>%lld días con registros</string>
		</dict>
	</dict>
	<key>%lld days · worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · máximo %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld día</string>
			<key>other</key>
			<string>%lld días</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · %@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld elemento</string>
			<key>other</key>
			<string>%lld elementos</string>
		</dict>
	</dict>
	<key>%lld tablets left. Time to ask for a refill.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Queda %lld comprimido. Es hora de pedir más.</string>
			<key>other</key>
			<string>Quedan %lld comprimidos. Es hora de pedir más.</string>
		</dict>
	</dict>
	<key>%lld weight entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld registro de peso</string>
			<key>other</key>
			<string>%lld registros de peso</string>
		</dict>
	</dict>
	<key>%lld-day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Racha de %lld día</string>
			<key>other</key>
			<string>Racha de %lld días</string>
		</dict>
	</dict>
	<key>- %@: %lld days, worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>- %@: %#@n@, máximo %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld día</string>
			<key>other</key>
			<string>%lld días</string>
		</dict>
	</dict>
	<key>About %lld days left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
