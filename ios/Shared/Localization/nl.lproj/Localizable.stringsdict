<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days of logs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dag met notities</string>
			<key>other</key>
			<string>%lld dagen met notities</string>
		</dict>
	</dict>
	<key>%lld days · worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · ergst %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dag</string>
			<key>other</key>
			<string>%lld dagen</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · %@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>%lld tablets left. Time to ask for a refill.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Nog %lld tablet. Tijd voor een herhaalrecept.</string>
			<key>other</key>
			<string>Nog %lld tabletten. Tijd voor een herhaalrecept.</string>
		</dict>
	</dict>
	<key>%lld weight entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld gewichtsnotitie</string>
			<key>other</key>
			<string>%lld gewichtsnotities</string>
		</dict>
	</dict>
	<key>%lld-day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dag op rij</string>
			<key>other</key>
			<string>%lld dagen op rij</string>
		</dict>
	</dict>
	<key>- %@: %lld days, worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>- %@: %#@n@, ergst %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dag</string>
			<key>other</key>
			<string>%lld dagen</string>
		</dict>
	</dict>
	<key>About %lld days left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
