		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dag uit Apple Gezondheid getoond.</string>
			<key>other</key>
			<string>%lld dagen uit Apple Gezondheid getoond.</string>
		</dict>
