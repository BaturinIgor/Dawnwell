			<string>%lld painokirjausta</string>
		</dict>
	</dict>
	<key>%lld-day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld päivä putkeen</string>
			<key>other</key>
			<string>%lld päivää putkeen</string>
		</dict>
	</dict>
	<key>- %@: %lld days, worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>- %@: %#@n@, pahimmillaan %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
