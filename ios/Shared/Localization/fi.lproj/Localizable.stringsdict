	<key>Showing %lld days from Apple Health.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Näytetään %lld päivä Apple Terveydestä.</string>
			<key>other</key>
			<string>Näytetään %lld päivää Apple Terveydestä.</string>
		</dict>
