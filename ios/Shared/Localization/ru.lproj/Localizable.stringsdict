<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days of logs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня записей</string>
			<key>many</key>
			<string>%lld дней записей</string>
			<key>one</key>
			<string>%lld день записей</string>
			<key>other</key>
			<string>%lld дня записей</string>
		</dict>
	</dict>
	<key>%lld days · worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · максимум %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня</string>
			<key>many</key>
			<string>%lld дней</string>
			<key>one</key>
			<string>%lld день</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>%lld items · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ · %@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld продукта</string>
			<key>many</key>
			<string>%lld продуктов</string>
			<key>one</key>
			<string>%lld продукт</string>
			<key>other</key>
			<string>%lld продукта</string>
		</dict>
	</dict>
	<key>%lld patterns found in your logs.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Найдено %lld закономерности в ваших записях.</string>
			<key>many</key>
			<string>Найдено %lld закономерностей в ваших записях.</string>
			<key>one</key>
			<string>Найдена %lld закономерность в ваших записях.</string>
			<key>other</key>
			<string>Найдено %lld закономерности в ваших записях.</string>
		</dict>
	</dict>
	<key>%lld tablets left. Time to ask for a refill.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Осталось %lld таблетки. Пора за новым рецептом.</string>
			<key>many</key>
			<string>Осталось %lld таблеток. Пора за новым рецептом.</string>
			<key>one</key>
