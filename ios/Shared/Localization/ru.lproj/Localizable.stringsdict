	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня подряд</string>
			<key>many</key>
			<string>%lld дней подряд</string>
			<key>one</key>
			<string>%lld день подряд</string>
			<key>other</key>
			<string>%lld дня подряд</string>
		</dict>
	</dict>
	<key>- %@: %lld days, worst %lld/5</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>- %@: %#@n@, максимум %lld/5</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld дня</string>
			<key>many</key>
			<string>%lld дней</string>
			<key>one</key>
			<string>%lld день</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>About %lld days left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Осталось примерно %lld дня</string>
			<key>many</key>
			<string>Осталось примерно %lld дней</string>
			<key>one</key>
			<string>Осталось примерно %lld день</string>
			<key>other</key>
			<string>Осталось примерно %lld дня</string>
		</dict>
	</dict>
	<key>Showing %lld days from Apple Health.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>Показано %lld дня из Apple Здоровья.</string>
			<key>many</key>
			<string>Показано %lld дней из Apple Здоровья.</string>
			<key>one</key>
			<string>Показан %lld день из Apple Здоровья.</string>
			<key>other</key>
			<string>Показано %lld дня из Apple Здоровья.</string>
