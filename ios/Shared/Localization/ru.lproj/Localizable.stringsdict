			<key>other</key>
			<string>Осталось %lld таблетки. Пора за новым рецептом.</string>
		</dict>
	</dict>
	<key>%lld weight entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld записи веса</string>
			<key>many</key>
			<string>%lld записей веса</string>
			<key>one</key>
			<string>%lld запись веса</string>
			<key>other</key>
			<string>%lld записи веса</string>
		</dict>
	</dict>
